{
  "name": "gatherer",
  "version": "0.1.0",
  "description": "A desktop notebook whose pages are HTML, gathered from the web.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "npm run build:apple-ai && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "build:apple-ai": "sh scripts/build-apple-ai.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "Gatherer",
  "author": "Ari",
  "build": {
    "appId": "com.gatherer.app",
    "productName": "Gatherer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "native/apple-ai/bin/gatherer-ai",
          "to": "gatherer-ai"
        }
      ],
      "x64ArchFiles": "Contents/Resources/gatherer-ai"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Ari"
    }
  }
}

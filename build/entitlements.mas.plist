<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Gathering pages and their images. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The browser extension hands pages to the app on 127.0.0.1 (loopback only). -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Folders the user picks: File > Import Notes reads one, export and sync write to one. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Sync keeps a security-scoped bookmark to its folder across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
  </dict>
</plist>
